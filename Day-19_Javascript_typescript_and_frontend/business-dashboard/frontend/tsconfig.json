{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ES2022",
        "moduleResolution": "Bundler",

        "strict": true,

        "noUncheckedIndexedAccess": true,
        "noImplicitOverride": true,
        "noFallthroughCasesInSwitch": true,
        "exactOptionalPropertyTypes": true,

        "esModuleInterop": true,
        "skipLibCheck": true,

        "noEmit": true
    },

    "include": [
        "ts/**/*.ts",
        "ai-client/**/*.ts"
    ]
}